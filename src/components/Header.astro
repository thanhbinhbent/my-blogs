---
import { getLangFromUrl, getLocalePath, useTranslations, withBase } from '../i18n/utils';
import { SITE_BRAND } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="container header-wrap">
    <a href={getLocalePath('/', lang)} class="brand" aria-label="Home">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect width="22" height="22" rx="6" fill="var(--clr-accent)"/>
        <path d="M5.5 15.5L9 7.5L13 13L16 9.5L18 15.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="brand-name">{SITE_BRAND}</span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <HeaderLink href={getLocalePath('/post', lang)}>{t('nav.blog')}</HeaderLink>
      <HeaderLink href={getLocalePath('/tags', lang)}>{t('nav.topics')}</HeaderLink>
      <HeaderLink href={withBase('/courses/')}>Courses</HeaderLink>
      <HeaderLink href={getLocalePath('/about', lang)}>{t('nav.about')}</HeaderLink>
    </nav>

    <div class="actions">
      <a href="https://github.com/thanhbinhbent" target="_blank" rel="noopener noreferrer"
         class="icon-btn" aria-label="GitHub profile" title="GitHub">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
      <LangSwitcher />
      <ThemeToggle />
      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg class="icon-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/>
        </svg>
        <svg class="icon-x" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label="Mobile navigation">
    <div class="container mobile-nav-inner">
      <HeaderLink href={getLocalePath('/post', lang)}>{t('nav.blog')}</HeaderLink>
      <HeaderLink href={getLocalePath('/tags', lang)}>{t('nav.topics')}</HeaderLink>
      <HeaderLink href={withBase('/courses/')}>Courses</HeaderLink>
      <HeaderLink href={getLocalePath('/about', lang)}>{t('nav.about')}</HeaderLink>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    border-bottom: 1px solid var(--bd);
  }

  .header-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    gap: 1rem;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: .5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-name {
    font-size: .95rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -.025em;
    transition: color .15s;
  }

  .brand:hover .brand-name { color: var(--clr-accent); }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    gap: .125rem;
  }

  /* Actions */
  .actions {
    display: flex;
    align-items: center;
    gap: .375rem;
    flex-shrink: 0;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-md);
    color: var(--fg-2);
    transition: background .15s, color .15s;
  }

  .icon-btn:hover {
    background: var(--bg-1);
    color: var(--fg);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-md);
    border: none;
    background: none;
    cursor: pointer;
    color: var(--fg-2);
    transition: background .15s, color .15s;
  }

  .hamburger:hover {
    background: var(--bg-1);
    color: var(--fg);
  }

  /* Mobile nav */
  .mobile-nav {
    border-top: 1px solid var(--bd);
    background: var(--surface);
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    padding-top: .75rem;
    padding-bottom: 1rem;
  }

  @media (max-width: 600px) {
    .nav { display: none; }
    .hamburger { display: flex; }
  }

  @media (min-width: 601px) {
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const btn  = document.getElementById('hamburger')!;
  const nav  = document.getElementById('mobile-nav')!;
  const menu = btn.querySelector('.icon-menu') as HTMLElement;
  const x    = btn.querySelector('.icon-x')    as HTMLElement;

  btn.addEventListener('click', () => {
    const open = !nav.hasAttribute('hidden');
    nav.toggleAttribute('hidden', open);
    btn.setAttribute('aria-expanded', String(!open));
    menu.style.display = open ? '' : 'none';
    x.style.display    = open ? 'none' : '';
  });
</script>
