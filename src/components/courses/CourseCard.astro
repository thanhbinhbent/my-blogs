---
import type { CollectionEntry } from 'astro:content';
import { getLevelLabel, getLevelColor } from '../../utils/courses';
import { withBase } from '../../i18n/utils';

interface Props {
  course: CollectionEntry<'courses'>;
}

const { course } = Astro.props;
const { title, description, level, tags, estimatedHours, totalLessons, color } = course.data;
const courseSlug = course.id;
const href = withBase(`/courses/${courseSlug}/`);
const levelLabel = getLevelLabel(level);
const levelColor = getLevelColor(level);

const K8S_ICON = `<svg viewBox="0 0 256 249" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="M82.085 25.68C79.4 27.14 77.74 29.97 77.74 33.02v25.94L50.82 43.15c-2.8-1.62-6.28-1.3-8.75.8L18.94 62.88c-2.47 2.1-3.33 5.54-2.13 8.56l9.87 24.62L1.95 108.6C-.65 110.14-2 113 .07 115.98l.76 1.2c.01.02.03.04.04.06l16.42 25.72c1.66 2.6 4.76 3.83 7.77 3.08l25.56-6.4 5.38 26.24c.68 3.32 3.42 5.76 6.8 6.05l28.62 2.5c3.38.3 6.52-1.62 7.82-4.74l10.4-24.98 24.98 10.4c3.12 1.3 6.7.44 8.88-2.13l18.6-22.1c2.18-2.57 2.32-6.24.34-8.97l-15.04-21.08 21.07-15.04c2.73-1.95 3.6-5.63 2.13-8.88l-10.4-24.98 24.98-10.4c3.12-1.3 4.96-4.52 4.52-7.87l-3.78-28.5c-.44-3.35-3.05-5.96-6.4-6.4l-26.24-3.5-2.02-26.43c-.26-3.38-2.76-6.08-6.1-6.67L91.3 24.48c-3.14-.56-6.25.6-7.82 3.26l-1.43 2.5z" opacity=".2"/><path d="M128 8.47c-2.97 0-5.93.78-8.56 2.34L33.46 61.73c-5.28 3.05-8.56 8.7-8.56 14.8v101.94c0 6.1 3.28 11.75 8.56 14.8l85.98 49.6c5.28 3.05 11.84 3.05 17.12 0l85.98-49.6c5.28-3.05 8.56-8.7 8.56-14.8V76.53c0-6.1-3.28-11.75-8.56-14.8L136.56 10.8C133.93 9.25 130.97 8.47 128 8.47z" fill="none" stroke="currentColor" stroke-width="8"/><path d="M128 31.5L52.5 75v87l75.5 43.6L203.5 162V75L128 31.5z" opacity=".15"/><circle cx="128" cy="128" r="20"/><line x1="128" y1="108" x2="128" y2="40" stroke="currentColor" stroke-width="8"/><line x1="128" y1="148" x2="128" y2="216" stroke="currentColor" stroke-width="8"/><line x1="114" y1="120" x2="54" y2="85" stroke="currentColor" stroke-width="8"/><line x1="142" y1="136" x2="202" y2="171" stroke="currentColor" stroke-width="8"/><line x1="114" y1="136" x2="54" y2="171" stroke="currentColor" stroke-width="8"/><line x1="142" y1="120" x2="202" y2="85" stroke="currentColor" stroke-width="8"/></svg>`;
---

<a href={href} class="course-card" style={`--c: ${color ?? '#2563EB'}`}>

  <!-- Visual cover -->
  <div class="card-cover">
    <div class="card-cover-bg"></div>
    <div class="card-icon" aria-hidden="true">
      <Fragment set:html={K8S_ICON} />
    </div>
    <div class="card-cover-meta">
      <span class="level-badge" style={`color: ${levelColor}`}>{levelLabel}</span>
    </div>
  </div>

  <!-- Body -->
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>

    <div class="card-stats">
      {totalLessons && (
        <span class="stat-chip">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          {totalLessons} lessons
        </span>
      )}
      {estimatedHours && (
        <span class="stat-chip">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          ~{estimatedHours}h
        </span>
      )}
      <span class="stat-chip lang-chip">EN</span>
    </div>

    <div class="card-tags">
      {tags.slice(0, 3).map(tag => (
        <span class="card-tag">{tag}</span>
      ))}
      {tags.length > 3 && <span class="card-tag muted">+{tags.length - 3}</span>}
    </div>
  </div>

  <!-- Progress footer -->
  <div class="card-footer" data-course-slug={courseSlug}>
    <div class="prog-track">
      <div class="prog-fill" style="width:0%"></div>
    </div>
    <div class="prog-row">
      <span class="prog-label">Not started</span>
      <span class="prog-cta">
        Start learning
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </span>
    </div>
  </div>
</a>

<script>
  document.querySelectorAll<HTMLElement>('.card-footer[data-course-slug]').forEach(el => {
    const slug = el.dataset.courseSlug!;
    try {
      const p = JSON.parse(localStorage.getItem(`course_progress_${slug}`) ?? '{}');
      const done = (p.completedLessons ?? []).length;
      if (done === 0) return;
      const totalEl = el.closest('.course-card')?.querySelector('.stat-chip');
      const totalMatch = totalEl?.textContent?.match(/\d+/);
      const total = totalMatch ? parseInt(totalMatch[0]) : 0;
      const pct = total > 0 ? Math.round(done / total * 100) : 0;
      el.querySelector<HTMLElement>('.prog-fill')!.style.width = `${pct}%`;
      el.querySelector<HTMLElement>('.prog-label')!.textContent = `${pct}% complete · ${done}/${total} lessons`;
      el.querySelector<HTMLElement>('.prog-cta')!.innerHTML = 'Continue <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';
    } catch {}
  });
</script>

<style>
.course-card {
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--bd);
  border-radius: var(--r-xl);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
  box-shadow: var(--sh-sm);
}

.course-card:hover {
  box-shadow: 0 20px 40px rgba(0,0,0,.1), 0 4px 12px rgba(0,0,0,.06);
  border-color: color-mix(in srgb, var(--c) 40%, var(--bd));
  transform: translateY(-3px);
  color: inherit;
}

/* Visual cover */
.card-cover {
  position: relative;
  height: 120px;
  overflow: hidden;
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--c) 18%, var(--bg-1)) 0%,
    color-mix(in srgb, var(--c) 8%, var(--bg)) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(color-mix(in srgb, var(--c) 15%, transparent) 1px, transparent 1px);
  background-size: 20px 20px;
}

.card-cover-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 80% 50%, color-mix(in srgb, var(--c) 25%, transparent) 0%, transparent 60%);
}

.card-icon {
  position: relative;
  z-index: 1;
  width: 56px;
  height: 56px;
  color: var(--c);
  opacity: .55;
}

.card-icon svg { width: 100%; height: 100%; }

.card-cover-meta {
  position: absolute;
  top: .75rem;
  left: .875rem;
  z-index: 2;
}

.level-badge {
  font-size: .65rem;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  background: color-mix(in srgb, currentColor 12%, var(--surface));
  padding: .25em .7em;
  border-radius: 99px;
  border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
}

/* Body */
.card-body {
  padding: 1.25rem 1.375rem 1rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: .625rem;
}

.card-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.3;
  letter-spacing: -.02em;
  margin: 0;
}

.card-desc {
  font-size: .8125rem;
  color: var(--fg-2);
  line-height: 1.55;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-stats {
  display: flex;
  align-items: center;
  gap: .375rem;
  flex-wrap: wrap;
}

.stat-chip {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .7rem;
  font-weight: 600;
  color: var(--fg-2);
  background: var(--bg-1);
  border: 1px solid var(--bd);
  padding: .25em .6em;
  border-radius: 99px;
}

.lang-chip { color: var(--fg-3); }

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .3rem;
  margin-top: .125rem;
}

.card-tag {
  font-size: .6875rem;
  color: var(--fg-3);
  background: var(--bg-1);
  border: 1px solid var(--bd);
  padding: .15em .55em;
  border-radius: 99px;
}

.card-tag.muted { opacity: .6; }

/* Footer / progress */
.card-footer {
  padding: .875rem 1.375rem;
  border-top: 1px solid var(--bd);
  background: var(--bg-1);
  display: flex;
  flex-direction: column;
  gap: .5rem;
}

.prog-track {
  height: 3px;
  background: var(--bg-2);
  border-radius: 99px;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background: var(--c);
  border-radius: 99px;
  transition: width .5s ease;
}

.prog-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prog-label {
  font-size: .7rem;
  color: var(--fg-3);
}

.prog-cta {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  font-size: .7rem;
  font-weight: 700;
  color: var(--c);
  letter-spacing: .01em;
}

.course-card:hover .prog-cta { text-decoration: underline; }
</style>
