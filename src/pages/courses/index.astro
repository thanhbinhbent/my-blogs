---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CourseCard from '../../components/courses/CourseCard.astro';

const allCourses = await getCollection('courses', c => c.data.published);
const sorted = allCourses.sort((a, b) => a.data.order - b.data.order);
---

<html lang="en">
  <head>
    <BaseHead
      title="Courses — Learn by Doing"
      description="Hands-on, in-depth technical courses on Automation Testing, DevOps, AI, and more. No login required — progress saved locally."
    />
  </head>

  <body>
    <Header />

    <main>
      <!-- ── Hero ── -->
      <section class="hero">
        <div class="hero-grid-bg" aria-hidden="true"></div>
        <div class="container">
          <div class="hero-inner">

            <div class="hero-left">
              <a href="#courses" class="hero-eyebrow">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span>Automation · DevOps · AI</span>
              </a>

              <h1 class="hero-title">
                Master
                <span class="hero-highlight"> Automation,<br>DevOps & AI</span>
              </h1>

              <p class="hero-desc">
                Practical, in-depth courses on Test Automation, DevOps engineering,
                and AI-powered development. Learn by doing — no account needed.
              </p>

              <ul class="hero-features">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Test Automation (Playwright, Selenium, k6)
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  DevOps & Cloud Native (K8s, Docker, CI/CD)
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  AI Engineering (LLMs, Agents, RAG)
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Free · No account · Progress saved locally
                </li>
              </ul>
            </div>

            <div class="hero-right" aria-hidden="true">
              <div class="hero-card-mock">
                <div class="mock-header">
                  <div class="mock-dots">
                    <span></span><span></span><span></span>
                  </div>
                  <span class="mock-title">kubernetes • module 1</span>
                </div>
                <div class="mock-body">
                  <div class="mock-progress-label">
                    <span>Introduction</span>
                    <span class="mock-pct">3/4 done</span>
                  </div>
                  <div class="mock-bar">
                    <div class="mock-bar-fill" style="width:75%"></div>
                  </div>
                  <div class="mock-lessons">
                    <div class="mock-lesson done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      What is Kubernetes?
                    </div>
                    <div class="mock-lesson done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      Why Kubernetes?
                    </div>
                    <div class="mock-lesson done">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      Architecture Overview
                    </div>
                    <div class="mock-lesson active">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                      Quiz · 5 questions
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ── Courses ── -->
      <section class="courses-section" id="courses">
        <div class="container">
          <div class="section-header">
            <div class="section-left">
              <h2 class="section-title">All Courses</h2>
              <span class="section-count">{sorted.length} available</span>
            </div>
          </div>

          {sorted.length === 0 ? (
            <div class="empty-state">
              <p>Courses are being prepared. Check back soon!</p>
            </div>
          ) : (
            <div class="courses-grid">
              {sorted.map(course => <CourseCard course={course} />)}
            </div>
          )}

          <div class="more-coming">
            <div class="more-inner">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              <span>More courses coming soon — Playwright, CI/CD, LLM Agents, and more</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
/* ── Hero ── */
.hero {
  position: relative;
  padding: 5rem 0 4.5rem;
  border-bottom: 1px solid var(--bd);
  overflow: hidden;
  background: linear-gradient(145deg,
    color-mix(in srgb, #2563EB 9%, var(--bg)) 0%,
    var(--bg) 52%,
    color-mix(in srgb, #7C3AED 7%, var(--bg)) 100%
  );
}

.hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(color-mix(in srgb, var(--fg) 9%, transparent) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse 90% 90% at 20% 40%, black 0%, transparent 75%);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 4rem;
  align-items: center;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--clr-course);
  background: color-mix(in srgb, var(--clr-course) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--clr-course) 25%, transparent);
  padding: .35em 1em;
  border-radius: 99px;
  text-decoration: none;
  margin-bottom: 1.5rem;
  transition: background .15s;
}

.hero-eyebrow:hover { background: color-mix(in srgb, var(--clr-course) 16%, transparent); }

.hero-title {
  font-size: clamp(2.25rem, 4.5vw, 3.25rem);
  font-weight: 900;
  letter-spacing: -.045em;
  line-height: 1.1;
  color: var(--fg);
  margin-bottom: 1.25rem;
}

.hero-highlight {
  background: linear-gradient(135deg, var(--clr-course) 0%, var(--clr-quiz) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-desc {
  font-size: 1.0625rem;
  color: var(--fg-2);
  line-height: 1.7;
  max-width: 460px;
  margin-bottom: 1.75rem;
}

.hero-features {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: .5rem;
}

.hero-features li {
  display: flex;
  align-items: center;
  gap: .5rem;
  font-size: .875rem;
  color: var(--fg-2);
}

.hero-features svg { color: var(--clr-accent); flex-shrink: 0; }

/* Mock card */
.hero-right { display: flex; justify-content: center; }

.hero-card-mock {
  background: var(--surface);
  border: 1px solid var(--bd);
  border-radius: var(--r-xl);
  box-shadow: 0 24px 48px rgba(0,0,0,.1), 0 4px 12px rgba(0,0,0,.06);
  overflow: hidden;
  width: 340px;
  transform: perspective(800px) rotateY(-6deg) rotateX(2deg);
  transition: transform .3s ease;
}

.hero-card-mock:hover {
  transform: perspective(800px) rotateY(-2deg) rotateX(1deg);
}

.mock-header {
  display: flex;
  align-items: center;
  gap: .625rem;
  padding: .75rem 1rem;
  background: var(--bg-1);
  border-bottom: 1px solid var(--bd);
}

.mock-dots { display: flex; gap: .3rem; }
.mock-dots span {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--bg-2);
}
.mock-dots span:first-child { background: #ff5f57; }
.mock-dots span:nth-child(2) { background: #febc2e; }
.mock-dots span:last-child { background: #28c840; }

.mock-title {
  font-size: .6875rem;
  font-weight: 600;
  color: var(--fg-3);
  font-family: ui-monospace, monospace;
}

.mock-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }

.mock-progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: .75rem;
  color: var(--fg-2);
  font-weight: 600;
}

.mock-pct { color: var(--clr-accent); }

.mock-bar {
  height: 6px;
  background: var(--bg-2);
  border-radius: 99px;
  overflow: hidden;
}

.mock-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--clr-course), var(--clr-accent));
  border-radius: 99px;
}

.mock-lessons { display: flex; flex-direction: column; gap: .5rem; }

.mock-lesson {
  display: flex;
  align-items: center;
  gap: .5rem;
  font-size: .8125rem;
  color: var(--fg-3);
  padding: .375rem .5rem;
  border-radius: var(--r-sm);
}

.mock-lesson.done {
  color: var(--fg-2);
  text-decoration: line-through;
}

.mock-lesson.done svg { color: var(--clr-accent); }

.mock-lesson.active {
  color: var(--clr-course);
  font-weight: 600;
  background: color-mix(in srgb, var(--clr-course) 8%, transparent);
}

.mock-lesson.active svg { color: var(--clr-quiz); }

/* ── Courses section ── */
.courses-section { padding: 3.5rem 0 5rem; }

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
}

.section-left { display: flex; align-items: baseline; gap: .75rem; }

.section-title {
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--fg);
  letter-spacing: -.03em;
}

.section-count {
  font-size: .8125rem;
  color: var(--fg-3);
}

.courses-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
  gap: 1.5rem;
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--fg-3);
}

.more-coming {
  margin-top: 2.5rem;
  display: flex;
  justify-content: center;
}

.more-inner {
  display: inline-flex;
  align-items: center;
  gap: .625rem;
  font-size: .875rem;
  color: var(--fg-3);
  background: var(--bg-1);
  border: 1px solid var(--bd);
  border-style: dashed;
  padding: .75rem 1.5rem;
  border-radius: 99px;
}

.more-inner svg { color: var(--fg-3); }

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-right { display: none; }
  .hero { padding: 3.5rem 0 3rem; }
}

@media (max-width: 600px) {
  .hero-title { font-size: 2rem; }
  .courses-section { padding: 2.5rem 0 4rem; }
}
</style>
