---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { AUTHOR, GITHUB_USERNAME, SITE_TITLE, TWITTER_HANDLE } from '../../consts';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<!doctype html>
<html lang="vi">
  <head>
    <BaseHead
      title={`${t('about.title')} · ${SITE_TITLE}`}
      description={`Tìm hiểu thêm về ${AUTHOR} và blog này.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <div class="container">
        <div class="about-wrap">

          <header class="about-hd">
            <h1>{t('about.title')}</h1>
            <p class="about-lead">{t('about.lead')}</p>
          </header>

          <div class="about-grid">
            <div class="about-main">
              <section class="about-section">
                <h2>{t('about.h2.intro')}</h2>
                <p>{t('about.p1')}</p>
                <p>{t('about.p2')}</p>
              </section>

              <section class="about-section">
                <h2>{t('about.h2.topics')}</h2>
                <ul class="topic-list">
                  <li>
                    <span class="topic-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    </span>
                    <div>
                      <strong>{t('about.topic.webdev')}</strong>
                      <span>{t('about.topic.webdev.desc')}</span>
                    </div>
                  </li>
                  <li>
                    <span class="topic-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                    </span>
                    <div>
                      <strong>{t('about.topic.ai')}</strong>
                      <span>{t('about.topic.ai.desc')}</span>
                    </div>
                  </li>
                  <li>
                    <span class="topic-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    </span>
                    <div>
                      <strong>{t('about.topic.testing')}</strong>
                      <span>{t('about.topic.testing.desc')}</span>
                    </div>
                  </li>
                  <li>
                    <span class="topic-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    </span>
                    <div>
                      <strong>{t('about.topic.oss')}</strong>
                      <span>{t('about.topic.oss.desc')}</span>
                    </div>
                  </li>
                </ul>
              </section>

              <section class="about-section">
                <h2>{t('about.h2.contact')}</h2>
                <p>{t('about.contact.p')}</p>
                <div class="social-links">
                  <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer" class="social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                    <span>@{GITHUB_USERNAME}</span>
                  </a>
                  <a href={`https://twitter.com/${TWITTER_HANDLE.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.63L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
                    <span>{TWITTER_HANDLE}</span>
                  </a>
                </div>
              </section>
            </div>

            <div class="about-side">
              <div class="info-card">
                <h3>{t('about.facts.title')}</h3>
                <dl class="fact-list">
                  <div class="fact-row">
                    <dt>{t('about.facts.role')}</dt>
                    <dd>{t('about.facts.role.val')}</dd>
                  </div>
                  <div class="fact-row">
                    <dt>{t('about.facts.focus')}</dt>
                    <dd>{t('about.facts.focus.val')}</dd>
                  </div>
                  <div class="fact-row">
                    <dt>{t('about.facts.stack')}</dt>
                    <dd>{t('about.facts.stack.val')}</dd>
                  </div>
                  <div class="fact-row">
                    <dt>{t('about.facts.site')}</dt>
                    <dd>{t('about.facts.site.val')}</dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
.about-wrap { padding: 3rem 0 5rem; }
.about-hd { padding-bottom: 2rem; border-bottom: 1px solid var(--bd); margin-bottom: 3rem; }
.about-hd h1 { font-size: clamp(2rem,5vw,2.75rem); letter-spacing:-.04em; margin-bottom:.75rem; }
.about-lead { font-size: 1.125rem; color: var(--fg-2); line-height: 1.65; max-width: 580px; margin: 0; }
.about-grid { display: grid; grid-template-columns: 1fr 240px; gap: 4rem; align-items: start; }
.about-section { margin-bottom: 2.5rem; }
.about-section:last-child { margin-bottom: 0; }
.about-section h2 { font-size: 1.25rem; font-weight: 700; letter-spacing: -.02em; color: var(--fg); margin-bottom: 1rem; }
.about-section p { font-size: .9375rem; color: var(--fg-2); line-height: 1.75; margin-bottom: .875rem; }
.about-section p:last-child { margin-bottom: 0; }
.topic-list { list-style: none; display: flex; flex-direction: column; gap: .875rem; }
.topic-list li { display: flex; gap: .875rem; align-items: flex-start; }
.topic-icon { flex-shrink: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--clr-accent) 10%, transparent); color: var(--clr-accent); border-radius: var(--r-sm); margin-top: 1px; }
.topic-list strong { display: block; font-size: .9375rem; font-weight: 600; color: var(--fg); margin-bottom: .125rem; }
.topic-list span { font-size: .875rem; color: var(--fg-2); line-height: 1.5; }
.social-links { display: flex; flex-direction: column; gap: .625rem; margin-top: 1.25rem; }
.social-link { display: inline-flex; align-items: center; gap: .625rem; font-size: .9375rem; font-weight: 500; color: var(--fg-2); padding: .625rem .875rem; border: 1px solid var(--bd); border-radius: var(--r-md); transition: border-color .15s, background .15s, color .15s; text-decoration: none; }
.social-link:hover { border-color: var(--clr-accent); background: color-mix(in srgb, var(--clr-accent) 6%, var(--surface)); color: var(--fg); }
.info-card { position: sticky; top: calc(var(--nav-h) + 1.5rem); background: var(--surface); border: 1px solid var(--bd); border-radius: var(--r-lg); padding: 1.5rem; }
.info-card h3 { font-size: .8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-3); margin-bottom: 1rem; }
.fact-list { display: flex; flex-direction: column; gap: .75rem; }
.fact-row { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; font-size: .875rem; }
.fact-row dt { color: var(--fg-3); flex-shrink: 0; }
.fact-row dd { color: var(--fg); font-weight: 500; text-align: right; }
@media (max-width: 768px) {
  .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .about-side { order: -1; }
  .info-card { position: static; }
}
</style>
